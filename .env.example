# ─────────────────────────────────────────────────────────────────
#  BOT ADMINISTRATIVO — Arquivo de Configuração (.env)
#  Copie este arquivo para .env e preencha cada variável abaixo.
#  Você também pode preencher tudo pelo Painel Admin em vez de editar
#  este arquivo manualmente.
# ─────────────────────────────────────────────────────────────────

# ── Identidade do Bot ─────────────────────────────────────────────
# Nome da organização/cliente e nome do bot — usados no prompt e no painel.
ORG_NAME=sua organização
BOT_NAME=Assistente Virtual

# Idioma de resposta (pt-BR, en-US, es-ES, etc.)
BOT_LANGUAGE=pt-BR

# Instruções extras específicas desta instalação, anexadas ao prompt
# base do bot. Use para regras de negócio sem precisar editar código.
# Exemplo: "Sempre pergunte o CPF antes de gerar relatórios de doações."
SYSTEM_PROMPT_EXTRA=

# ── WhatsApp ──────────────────────────────────────────────────────
# ID do grupo que o bot vai monitorar.
# Deixe em branco para operar em modo multi-tenant: o bot responde em
# qualquer grupo autorizado e usa configurações por grupo salvas no
# banco (tabela bot_configs, gerenciada por services/config.js).
GROUP_ID=

# ── Provedor de IA ────────────────────────────────────────────────
# Escolha UMA das opções: groq | gemini | anthropic
AI_PROVIDER=groq

# Chave de API do provedor escolhido acima
#   Groq    → https://console.groq.com/keys          (começa com gsk_)
#   Gemini  → https://aistudio.google.com/app/apikey (começa com AIza)
#   Claude  → https://console.anthropic.com/keys     (começa com sk-ant-)
AI_API_KEY=

# Modelo específico (deixe em branco para usar o padrão do provedor escolhido).
# Esta MESMA variável é usada por qualquer um dos três provedores.
#   Groq:      llama-3.3-70b-versatile
#   Gemini:    gemini-2.5-flash
#   Anthropic: claude-haiku-4-5-20251001
AI_MODEL=

# ── Banco de Dados PostgreSQL ─────────────────────────────────────
# Sugestão gratuita: https://neon.tech (0.5 GB grátis)
# Formato:  postgres://usuario:senha@host:5432/nome_banco
# O bot descobre tabelas/colunas automaticamente (sem schema fixo).
DATABASE_URL=

# Provedores gerenciados (ex: Neon.tech) exigem conexão SSL — isso já
# é o padrão. Só defina PG_SSL=false se estiver usando um Postgres
# local sem SSL configurado.
PG_SSL=

# ── Google Sheets ─────────────────────────────────────────────────
# ID da planilha principal: está na URL entre /d/ e /edit
# Ex: https://docs.google.com/spreadsheets/d/  →ESTE_TRECHO←  /edit
SPREADSHEET_ID=

# (Opcional, avançado) Configure múltiplas planilhas de uma vez.
# Se preenchido, tem prioridade sobre SPREADSHEET_ID acima.
# Formato: array JSON de objetos {"id": "...", "nome": "..."}
# Exemplo:
# SPREADSHEETS=[{"id":"abc123","nome":"Apoiadores"},{"id":"xyz789","nome":"Financeiro"}]
SPREADSHEETS=

# (Opcional) Nome de coluna a priorizar como "nome da pessoa" em buscas.
# Se vazio, o bot tenta detectar automaticamente qualquer coluna que
# contenha "nome".
COLUNA_NOME_PRIORITARIA=

# (Opcional) Nomes de coluna, separados por vírgula, a priorizar como
# "contato" em buscas. Padrão: whatsapp,telefone,celular
COLUNA_CONTATO_PRIORITARIA=whatsapp,telefone,celular

# ── Google Drive ──────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=

# ── Google Cloud (Service Account) ───────────────────────────────
# JSON da conta de serviço em UMA ÚNICA LINHA (sem quebras de linha).
GOOGLE_CREDENTIALS_JSON=

# ── Funcionalidades (ativar/desativar) ────────────────────────────
# Desative o que não for usado nesta instalação — evita erros de
# "não configurado" e reduz chamadas desnecessárias de ferramentas.
ENABLE_DB=true
ENABLE_SHEETS=true
ENABLE_DRIVE=true
ENABLE_CALENDAR=true
ENABLE_WEB_SEARCH=true
ENABLE_REPORTS=true

# ── Limites (avançado) ────────────────────────────────────────────
# Quantas linhas de planilha o bot pode ver de uma vez ao chamar
# ler_planilha. Buscas agregadas (segmentar_apoiadores/filtrar) não
# são afetadas por este limite.
SHEET_ROW_LIMIT=200

# Quantos registros de SQL o bot pode ver de uma vez.
SQL_ROW_LIMIT=100

# Quantas mensagens (usuário+assistente) o bot mantém de histórico
# por conversa, antes de começar a "esquecer" o início da conversa.
HISTORY_SIZE=6

# ── Servidor ──────────────────────────────────────────────────────
PORT=3000

# URL pública gerada pelo Cloudflare Tunnel (necessária para links de PDF no WhatsApp)
BASE_URL=http://localhost:3000

# Pasta onde os PDFs gerados ficam salvos
REPORTS_DIR=reports
