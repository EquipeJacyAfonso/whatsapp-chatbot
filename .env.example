# ─────────────────────────────────────────────────────
# CONFIGURAÇÕES DO CHATBOT
# Copie para .env e preencha com suas credenciais
# ─────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────
PORT=5000
# BASE_URL é a URL pública gerada pelo Render (para links de PDF)
BASE_URL=https://seu-app.onrender.com

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o          # ou gpt-4o-mini para gastar menos

# ── PostgreSQL ────────────────────────────────────────
# Use a connection string completa (Render fornece isso automaticamente
# se você criar um banco lá, via variável DATABASE_URL)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# ── Google Drive / Sheets ─────────────────────────────
# Opção A: caminho para o arquivo JSON (local)
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# Opção B: conteúdo JSON em uma linha só (recomendado para Render)
# Cole o conteúdo inteiro do JSON aqui entre aspas simples:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Evolution API ─────────────────────────────────────
EVOLUTION_API_URL=https://sua-evolution.onrender.com
EVOLUTION_API_KEY=sua-chave-secreta
EVOLUTION_INSTANCE=nome-da-instancia

# ── Relatórios ────────────────────────────────────────
REPORTS_DIR=reports

# ── Sincronização Google Sheets → PostgreSQL ──────────────
# ID da planilha (está na URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
SHEETS_SPREADSHEET_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ
SHEETS_ABA=Respostas ao formulário 1

# Intervalo de sync automático em minutos (padrão: 30)
SYNC_INTERVAL_MINUTES=30
