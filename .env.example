# ─────────────────────────────────────────────────────────────
# .env — WhatsApp Chatbot (Jacy Afonso)
# NUNCA suba este arquivo para o GitHub!
# Adicione .env no seu .gitignore
# ─────────────────────────────────────────────────────────────

# ── Google Gemini ──────────────────────────────────────────────
# Obtenha grátis em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# Modelo recomendado (gratuito, rápido):
# gemini-2.0-flash        → melhor custo-benefício, sem limite de uso pesado
# gemini-1.5-flash-8b     → mais leve ainda
GEMINI_MODEL=gemini-2.0-flash

# ── Evolution API (WhatsApp bridge) ───────────────────────────
# Rodando localmente via Docker Desktop
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=crie-uma-chave-secreta-aqui
EVOLUTION_INSTANCE=PT-JACY

# ── PostgreSQL (Neon.tech gratuito) ───────────────────────────
# Crie em https://neon.tech → copie a "Connection string"
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ── Google Sheets ─────────────────────────────────────────────
# ID da planilha (parte da URL entre /d/ e /edit)
# Ex: https://docs.google.com/spreadsheets/d/ESTE_ID_AQUI/edit
SPREADSHEET_ID=ID_DA_SUA_PLANILHA_AQUI

# Cole o JSON inteiro da Service Account em uma linha (use jq ou o script abaixo)
# Para converter: python -c "import json,sys; print(json.dumps(json.load(open('credenciais.json'))))"
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Relatórios ────────────────────────────────────────────────
REPORTS_DIR=reports

# ── URL pública (gerada pelo Cloudflare Tunnel) ───────────────
# Preencha após rodar: cloudflared tunnel --url http://localhost:5000
BASE_URL=https://SEU-TUNEL.trycloudflare.com
