# ─────────────────────────────────────────────────────────────────
#  JACY BOT — Arquivo de Configuração (.env)
#  Copie este arquivo para .env e preencha cada variável abaixo.
#  Você também pode preencher tudo pelo Painel Admin em vez de editar
#  este arquivo manualmente.
# ─────────────────────────────────────────────────────────────────

# ── WhatsApp ──────────────────────────────────────────────────────
# ID do grupo que o bot vai monitorar.
# Deixe em branco na primeira execução; o bot vai listar os grupos
# disponíveis no terminal depois que você escanear o QR Code.
GROUP_ID=

# ── Provedor de IA ────────────────────────────────────────────────
# Escolha UMA das opções: groq | gemini | anthropic
# Recomendação de custo: groq (grátis) > gemini (grátis) > anthropic (pago, mas barato)
AI_PROVIDER=groq

# Chave de API do provedor escolhido acima
#   Groq    → https://console.groq.com/keys          (começa com gsk_)
#   Gemini  → https://aistudio.google.com/app/apikey (começa com AIza)
#   Claude  → https://console.anthropic.com/keys     (começa com sk-ant-)
AI_API_KEY=

# Modelo específico (deixe em branco para usar o padrão do provedor escolhido).
# Esta MESMA variável é usada por qualquer um dos três provedores.
#   Groq:      llama-3.3-70b-versatile
#   Gemini:    gemini-2.5-flash
#   Anthropic: claude-haiku-4-5-20251001
AI_MODEL=

# ── Banco de Dados PostgreSQL ─────────────────────────────────────
# Sugestão gratuita: https://neon.tech (0.5 GB grátis)
# Formato:  postgres://usuario:senha@host:5432/nome_banco
DATABASE_URL=

# Provedores gerenciados (ex: Neon.tech) exigem conexão SSL — isso já
# é o padrão. Só defina PG_SSL=false se estiver usando um Postgres
# local sem SSL configurado.
PG_SSL=

# ── Google Sheets ─────────────────────────────────────────────────
# ID da planilha: está na URL do Google Sheets entre /d/ e /edit
# Ex: https://docs.google.com/spreadsheets/d/  →ESTE_TRECHO←  /edit
SPREADSHEET_ID=

# ── Google Drive ──────────────────────────────────────────────────
# ID da pasta do Drive onde ficam os PDFs administrativos.
# Abra a pasta no Drive; o ID está no final da URL do navegador.
GOOGLE_DRIVE_FOLDER_ID=

# ── Google Cloud (Service Account) ───────────────────────────────
# JSON da conta de serviço em UMA ÚNICA LINHA (sem quebras de linha).
# Use o Painel Admin para fazer upload do arquivo .json
# e ele converte automaticamente — ou rode no terminal:
#   node -e "console.log(JSON.stringify(require('./credenciais.json')))"
GOOGLE_CREDENTIALS_JSON=

# ── Servidor ──────────────────────────────────────────────────────
# Porta do servidor local (painel admin + download de PDFs)
PORT=3000

# URL pública gerada pelo Cloudflare Tunnel (necessária para links de PDF no WhatsApp)
# Após rodar o tunnel, copie a URL https://xxxx.trycloudflare.com aqui
BASE_URL=http://localhost:3000

# Pasta onde os PDFs gerados ficam salvos
REPORTS_DIR=reports
