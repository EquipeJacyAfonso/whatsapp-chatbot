# ─────────────────────────────────────────────
# Variáveis de ambiente — WhatsApp Chatbot
# Copie este arquivo para .env e preencha os valores
# NÃO suba o .env real para o GitHub!
# ─────────────────────────────────────────────

# ── Google Gemini (substitui OPENAI_API_KEY) ──
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCDL_HWFoBGwnEUut8LJ48e0SHZL81UFtM

# Modelo a usar (deixe em branco para usar o padrão: gemini-2.5-flash-lite-preview-06-17)
# Opções gratuitas:
#   gemini-2.5-flash-lite-preview-06-17  → 15 RPM, 1.000 req/dia (RECOMENDADO)
#   gemini-2.5-flash-preview-05-20       → 10 RPM, 250 req/dia
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17

# ── Evolution API (WhatsApp bridge) ───────────
EVOLUTION_API_URL=https://sua-evolution-api.railway.app
EVOLUTION_API_KEY=sua-chave-secreta-evolution
EVOLUTION_INSTANCE=nome-da-instancia

# ── PostgreSQL ────────────────────────────────
# No Railway, isso é preenchido automaticamente ao adicionar o plugin PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ── Google Drive / Sheets ─────────────────────
# Cole o conteúdo inteiro do JSON da Service Account em uma linha
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Relatórios PDF ────────────────────────────
REPORTS_DIR=reports
# URL base do seu serviço no Railway (gerada automaticamente)
BASE_URL=https://seu-bot.railway.app
